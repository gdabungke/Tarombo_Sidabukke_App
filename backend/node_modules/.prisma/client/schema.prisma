datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String     @id @default(uuid())
  username   String     @unique
  phone      String?    @unique
  email      String?    @unique
  password   String
  profilePic String?    @default("/uploads/default_avatar.png")
  role       String     @default("MEMBER")
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  logs       AuditLog[]
}

model Person {
  id              String   @id @default(uuid())
  fullName        String
  taromboName     String?
  nickname        String?
  gender          String   @default("UNKNOWN")
  generationLevel Int?
  birthDateEst    String?
  deathDateEst    String?
  isAlive         Boolean  @default(false)
  verification    String   @default("UNVERIFIED")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  parentRelations ChildRelation[] @relation("ChildToRelation")
  childRelations  ChildRelation[] @relation("ParentToRelation")
  unionsInitiated Union[]         @relation("PersonUnions")
  unionsPartner   Union[]         @relation("PartnerUnions")

  biography     Biography?
  mediaLinks    MediaLink[]
  branchMembers BranchMember[]
  claims        Claim[]
}

model Union {
  id              String  @id @default(uuid())
  personId        String
  partnerId       String
  marriageDateEst String?
  notes           String?

  person   Person          @relation("PersonUnions", fields: [personId], references: [id], onDelete: Cascade)
  partner  Person          @relation("PartnerUnions", fields: [partnerId], references: [id], onDelete: Cascade)
  children ChildRelation[]

  @@unique([personId, partnerId])
}

model ChildRelation {
  id           String  @id @default(uuid())
  parentId     String
  childId      String
  unionId      String?
  isBiological Boolean @default(true)
  orderIndex   Int     @default(1)

  parent Person @relation("ParentToRelation", fields: [parentId], references: [id], onDelete: Cascade)
  child  Person @relation("ChildToRelation", fields: [childId], references: [id], onDelete: Cascade)
  union  Union? @relation(fields: [unionId], references: [id], onDelete: SetNull)

  @@unique([parentId, childId])
}

model Biography {
  id             String  @id @default(uuid())
  personId       String  @unique
  contentBatak   String?
  contentIndo    String?
  sourceCitation String?
  person         Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Branch {
  id          String         @id @default(uuid())
  name        String
  description String?
  members     BranchMember[]
}

model BranchMember {
  id       String @id @default(uuid())
  branchId String
  personId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([branchId, personId])
}

model MediaLink {
  id       String  @id @default(uuid())
  personId String
  fileUrl  String
  caption  String?
  source   String?
  person   Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model Claim {
  id               String   @id @default(uuid())
  personId         String
  proposedName     String?
  proposedTarombo  String?
  proposedNotes    String?
  reason           String
  submitterName    String
  submitterContact String?
  status           String   @default("PENDING")
  reviewedBy       String?
  reviewNotes      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  tableName String
  recordId  String
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
